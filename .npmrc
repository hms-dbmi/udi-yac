# pnpm-related options (lifted from udi-grammar's pre-staged pnpm config)
# shamefully-hoist: added for Quasar app-vite, which resolved undeclared transitive
# deps. The Quasar demo app is gone; dropping this is untested.
shamefully-hoist=true
strict-peer-dependencies=false
# to get the latest compatible packages when creating the project https://github.com/pnpm/pnpm/issues/6463
resolution-mode=highest
