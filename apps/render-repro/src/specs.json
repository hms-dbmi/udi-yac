              "literal": null
            }
          },
          "drop y": {
            "if": {
              "op": "==",
              "left": {
                "window": "rank"
              },
              "right": {
                "literal": 1
              }
            },
            "then": {
              "literal": 0
            },
            "else": {
              "literal": null
            }
          }
        }
      },
      {
        "orderby": {
          "field": "percent",
          "order": "asc"
        }
