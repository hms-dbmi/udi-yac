{
  "name": "udi-render-repro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dev-only minimal reproduction of the stale-render bug (hms-dbmi/udi-yac#34), outside the YAC app.",
  "scripts": {
    "sync-data": "node ../../scripts/copy-sample-data.mjs public/data",
    "dev": "pnpm run sync-data && vite",
    "build": "pnpm run sync-data && tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md,html,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "udi-toolkit": "workspace:*",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.3"
  }
}
