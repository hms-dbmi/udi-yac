---
// One card per public data package, from the same catalog the app reads
// (sample-data/catalog.json), so the two cannot list different packages.
import { Card, CardGrid, LinkButton } from '@astrojs/starlight/components';
import catalog from '../../../../sample-data/catalog.json';

const appUrl = (packageId: string, sessionId?: string) => {
  const params = new URLSearchParams({ package: packageId });
  if (sessionId) params.set('session', sessionId);
  return `${import.meta.env.BASE_URL.replace(/\/$/, '')}/app/?${params}`;
};
---

<CardGrid>
  {
    catalog.packages.map((pkg) => (
      <Card title={pkg.title}>
        <p>{pkg.description}</p>
        {pkg.sessions.length > 0 && (
          <ul>
            {pkg.sessions.map((s: { id: string; title: string; description: string }) => (
              <li>
                <a href={appUrl(pkg.id, s.id)}>{s.title}</a>: {s.description}
              </li>
            ))}
          </ul>
        )}
        <LinkButton href={appUrl(pkg.id)} variant="secondary" icon="right-arrow">
          New session
        </LinkButton>
      </Card>
    ))
  }
</CardGrid>
