---
// The grammar editor: a spec on the left, its chart on the right. Full-viewport
// like the app page, outside the docs layout. Rendered client-only: Monaco and
// the toolkit's custom element need a browser.
import GrammarEditor from '../../components/GrammarEditor';
import 'udi-toolkit/style.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>UDI grammar editor</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body>
    <GrammarEditor client:only="react" />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    height: 100%;
    background: #fff;
    font-family: system-ui, sans-serif;
  }
  .shell {
    display: flex;
    flex-direction: column;
    height: 100vh;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    border-bottom: 1px solid #e5e5e5;
    font-size: 0.75rem;
    color: #171717;
  }
  .bar .brand {
    font-weight: 600;
    color: inherit;
    text-decoration: none;
  }
  .bar button {
    margin-left: auto;
    height: 1.75rem;
    padding: 0 0.75rem;
    border: 1px solid #e5e5e5;
    border-radius: 0.375rem;
    background: #fff;
    font: inherit;
    cursor: pointer;
  }
  .panes {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: 0;
  }
  .code {
    min-height: 0;
    border-right: 1px solid #e5e5e5;
  }
  /* minmax(0, …) above and min-width here keep a container-sized Vega view
     from ratcheting the pane wider on every resize. */
  .chart {
    min-width: 0;
    overflow: auto;
    padding: 1rem;
  }
  @media (max-width: 48rem) {
    .panes {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
    }
    .code {
      border-right: 0;
      border-bottom: 1px solid #e5e5e5;
    }
  }
</style>
