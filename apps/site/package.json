{
  "name": "udi-yac-site",
  "private": true,
  "type": "module",
  "description": "Landing page, docs and app page for YAC, published at /udi-yac/ on GitHub Pages",
  "scripts": {
    "sync-data": "node ../../scripts/copy-sample-data.mjs public/app/data",
    "sync-docs": "node scripts/sync-docs.mjs",
    "dev": "pnpm run sync-data && pnpm run sync-docs && astro dev",
    "build": "pnpm run sync-data && pnpm run sync-docs && astro build",
    "preview": "astro preview",
    "test": "node --test src/lib/catalog.test.ts"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@astrojs/starlight": "^0.42.0",
    "astro": "^7.4.1",
    "lz-string": "^1.5.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.0",
    "starlight-openapi": "^0.27.0",
    "starlight-typedoc": "^0.23.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "~6.0.3",
    "udi-toolkit": "workspace:*",
    "udi-yac": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
