{
  "name": "udi-grammar-app",
  "version": "0.0.1",
  "description": "Universal Discovery Interface Grammar",
  "productName": "Universal Discovery Interface Grammar",
  "author": "dev-lan <devinscottlange@gmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "sync-data": "node ../../scripts/copy-sample-data.mjs public/data",
    "dev": "pnpm run sync-data && quasar dev",
    "build": "pnpm run sync-data && quasar build",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@quasar/extras": "^1.18.0",
    "lodash": "^4.18.1",
    "lz-string": "^1.5.0",
    "monaco-editor": "^0.52.2",
    "pinia": "^3.0.4",
    "quasar": "^2.34.0",
    "udi-toolkit": "workspace:*",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^3.3.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.20.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vite-plugin-checker": "^0.14.5",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22",
    "npm": ">= 6.13.4"
  }
}
