{
  "name": "udi-yac",
  "version": "0.6.0",
  "description": "React implementation of the Universal Discovery Interface (UDI) chat — natural-language querying and visualization of biomedical datasets. Publishable as a library (`UDIChat` component) or as a standalone SPA.",
  "keywords": [
    "udi",
    "udi-yac",
    "udi-chat",
    "react",
    "visualization",
    "vega-lite",
    "biomedical",
    "hubmap",
    "llm",
    "chat"
  ],
  "homepage": "https://github.com/hms-dbmi/udi-yac/tree/main/packages/chat#readme",
  "bugs": {
    "url": "https://github.com/hms-dbmi/udi-yac/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hms-dbmi/udi-yac.git",
    "directory": "packages/chat"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/udi-yac.js",
  "module": "dist/udi-yac.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/udi-yac.js"
    },
    "./style.css": "./dist/udi-yac.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "sync-data": "node ../../scripts/copy-sample-data.mjs public/data",
    "dev": "pnpm run sync-data && vite",
    "build": "pnpm run sync-data && tsc -b && vite build",
    "build:lib": "tsc -b && vite build --mode lib",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:css": "node test/no-global-css-leaks.mjs",
    "test:ssr": "node test/ssr-import.mjs",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md,html,yaml,yml}": "prettier --write"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@microsoft/api-extractor": "^7.59.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-project-structure": "^3.14.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.52.0",
    "lz-string": "^1.5.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-grid-layout": "~2.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable": "^4.0.2",
    "shadcn": "^4.21.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "udi-toolkit": "workspace:*",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vite": "^8.3.3",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  }
}
