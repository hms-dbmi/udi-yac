      },
      "YACVisInstantiateRequest": {
        "properties": {
          "tool": {
            "type": "string",
            "title": "Tool",
            "description": "The template tool, from the render's `meta.tool_used`."
          },
          "toolArgs": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "additionalProperties": true,
                  "type": "object"
                }
              ]
            },
            "type": "object",
            "title": "Toolargs",
            "description": "The bindings, from the render's `meta.tool_args`, with the changed one replaced. Values are column names and literal values, except a stratifier `grouping`, which is an object. A list is a `<V*:list>` literal: several values, any of which matches (a survival curve's end events)."
          },
          "dataSchema": {
            "type": "string",
            "title": "Dataschema",
