# Your OpenAI API key. Leave blank to require callers to bring their own key
# via the X-OpenAI-Key header (e.g. the chat app's in-app key prompt).
OPENAI_API_KEY=

# Local dev: skip JWT auth. Unset (or 0) in production and set JWT_SECRET_KEY.
INSECURE_DEV_MODE=1
# JWT_SECRET_KEY=your-key-goes-here

# OAuth integration: verify tokens issued by an external identity provider
# (Keycloak, Globus, Auth0, Entra) instead of a shared secret. Mutually
# exclusive with JWT_SECRET_KEY. JWT_AUDIENCE is required here — without it,
# tokens the provider issued for its other clients would be accepted.
# JWT_JWKS_URL=https://idp.example/realms/udi/protocol/openid-connect/certs
# JWT_ALGORITHM=RS256
# JWT_AUDIENCE=udi-yac
# JWT_ISSUER=https://idp.example/realms/udi

# GPT model for orchestration (optional, defaults to gpt-5.4). With a custom
# OPENAI_BASE_URL this is that backend's model id.
# GPT_MODEL_NAME=gpt-5.4

# Any OpenAI-compatible backend (optional; defaults to api.openai.com).
# The backend must support function calling + JSON-schema structured outputs.
# Note: the OpenAI SDK reads this env var for every client it builds, so
# per-request X-OpenAI-Key callers are routed here too.
#   Azure AI Foundry: https://<resource>.openai.azure.com/openai/v1
#   Amazon Bedrock:   https://bedrock-mantle.<region>.api.aws/openai/v1
#   OpenRouter:       https://openrouter.ai/api/v1
#   Ollama / vLLM:    http://localhost:11434/v1  (OPENAI_API_KEY may be blank)
# OPENAI_BASE_URL=

# LangFuse observability (optional)
# LANGFUSE_SECRET_KEY=sk-your-key-goes-here
# LANGFUSE_PUBLIC_KEY=pk-your-key-goes-here
# LANGFUSE_HOST=https://your-langfuse-instance.com

# Server-side query backends (optional): path to a JSON config mapping
# package names to StarRocks/DuckDB connections, served via /v1/yac/query
# and /v1/yac/metadata. Generated by scripts/seed_starrocks.py — see
# dev/starrocks/README.md.
# UDI_QUERY_BACKENDS=starrocks-backends.json
