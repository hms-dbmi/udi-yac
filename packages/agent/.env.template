# Generated by scripts/gen_env_docs.py from ServerConfig — do not edit by hand.
# Describe a variable in src/udiagent/server/config.py and regenerate.
#
# Copy to .env (scripts/setup.mjs does this for you). Values here are the
# defaults; uncomment a line only to change one.

# === Authentication ===

# JWT signing key for self-issued tokens. Required unless
# `INSECURE_DEV_MODE=1` or `JWT_JWKS_URL` is set.
# JWT_SECRET_KEY=<paste output of: openssl rand -hex 32>

# JWT algorithm. Set to the identity provider's (e.g. `RS256`) when using
# `JWT_JWKS_URL`.
# JWT_ALGORITHM=HS256

# Verify externally issued tokens against an identity provider's JWKS endpoint
# instead of `JWT_SECRET_KEY`. Mutually exclusive with it.
# JWT_JWKS_URL=https://idp.example/realms/udi/protocol/openid-connect/certs

# Expected `iss` claim; validated only when set.
# JWT_ISSUER=https://idp.example/realms/udi

# Expected `aud` claim. Required with `JWT_JWKS_URL`.
# JWT_AUDIENCE=udi-yac

# Skip JWT verification entirely. Development only — never set this in
# production.
INSECURE_DEV_MODE=1

# === CORS ===

# Comma-separated list of browser origins allowed to call this server.
# Defaults to `*` (any origin). Note that credentialed requests are always
# permitted, so with `*` any site can call this server with a user's cookies —
# name your origins explicitly in production.
# UDI_CORS_ORIGINS=https://portal.example.org,https://staging.example.org

# === Model backend ===

# Model for orchestration; with a custom base URL, that backend's model id.
# Callers may override it per-request only by supplying their own
# `X-OpenAI-Key`.
# GPT_MODEL_NAME=gpt-5.4

# OpenAI API key. If unset, callers must supply one per-request via the
# `X-OpenAI-Key` header.
OPENAI_API_KEY=

# Root of any OpenAI-compatible backend (Azure AI Foundry, Bedrock,
# OpenRouter, Ollama, vLLM). Must support function calling and JSON-schema
# structured outputs. For Bedrock this is the static-API-key path; see
# `UDI_BEDROCK` for an IAM role.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Authenticate to Amazon Bedrock with SigV4 from the default AWS credential
# chain (EC2 instance profile, ECS task role, `AWS_PROFILE`,
# `~/.aws/credentials`), so no key is stored. Mutually exclusive with
# `OPENAI_API_KEY` and `OPENAI_BASE_URL`. Per-request `X-OpenAI-Key` headers
# are refused with a 403 in this mode, so no prompt reaches api.openai.com.
# Requires the `udiagent[bedrock]` extra.
# UDI_BEDROCK=0

# AWS region for Bedrock; also determines the endpoint. Required with
# `UDI_BEDROCK`, though the AWS SDK will also accept `AWS_DEFAULT_REGION` or
# `~/.aws/config` — there is no instance metadata fallback. Set
# `AWS_BEDROCK_BASE_URL` instead to reach a PrivateLink endpoint.
# AWS_REGION=us-east-1

# === Observability (all three or none) ===

# LangFuse public key. Tracing is off unless all three are set.
# LANGFUSE_PUBLIC_KEY=pk-your-key-goes-here

# LangFuse secret key. Tracing is off unless all three are set.
# LANGFUSE_SECRET_KEY=sk-your-key-goes-here

# LangFuse instance URL, e.g. `https://cloud.langfuse.com`.
# LANGFUSE_HOST=https://cloud.langfuse.com

# Tags traces with an environment label (e.g. `production`). Does not by
# itself enable tracing.
# LANGFUSE_ENVIRONMENT=production

# === Server-side query backends ===

# Path to a JSON file mapping package names to StarRocks/DuckDB connections,
# served via `/v1/yac/query` and `/v1/yac/metadata`. Written by the seed
# scripts — see `dev/duckdb/README.md`.
# UDI_QUERY_BACKENDS=duckdb-backends.json

# TTL for the introspected-metadata cache.
# UDI_METADATA_TTL_SECONDS=3600

# === Paths (override when installed from a wheel) ===

# Where the rotating log file goes. Defaults to `<package root>/logs`; file
# logging is skipped if unwritable.
# UDI_LOG_DIR=/var/log/udiagent

# Repo-level dev data for `/v1/yac/examples`. Defaults to `<package
# root>/data`; set this when installed from a wheel.
# UDI_DATA_DIR=/srv/udiagent/data
